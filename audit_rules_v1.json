{
  "ruleset_id": "kt_process_change_audit_rules_v1",
  "ruleset_version": "1.0",
  "purpose": "Deterministic audit rules for a process-change interview using the KT-inspired template.",
  "trace_policy": {
    "show_visible_rationale": true,
    "hide_chain_of_thought": true,
    "visible_trace_fields": [
      "rule_id",
      "field_id",
      "section_id",
      "passed",
      "reason",
      "evidence_needed"
    ]
  },
  "status_order": [
    "conflicted",
    "missing",
    "partial",
    "complete"
  ],
  "next_question_priority": [
    "mandatory_conflicted",
    "mandatory_missing",
    "mandatory_partial",
    "section_readiness_gap",
    "optional_conflicted",
    "optional_missing",
    "optional_partial"
  ],
  "global_field_rules": [
    {
      "rule_id": "GLOBAL-MANDATORY-HAS-USABLE-EVIDENCE",
      "applies_to": "mandatory_fields",
      "severity": "high",
      "status_when_failed": "missing",
      "description": "Mandatory fields must contain enough evidence to support a consultant recommendation.",
      "evidence_needed": "A concrete user statement, source, metric, owner, decision, risk, or operational detail."
    },
    {
      "rule_id": "GLOBAL-PARTIAL-NEEDS-FOLLOWUP",
      "applies_to": "partial_fields",
      "severity": "medium",
      "status_when_failed": "partial",
      "description": "Partial fields should trigger a follow-up before moving to lower-priority optional fields.",
      "evidence_needed": "Clarifying details that make the field specific, observable, and decision-useful."
    },
    {
      "rule_id": "GLOBAL-CONFLICT-RESOLVE-FIRST",
      "applies_to": "conflicted_fields",
      "severity": "critical",
      "status_when_failed": "conflicted",
      "description": "Conflicting facts must be resolved before relying on the field.",
      "evidence_needed": "The current truth, the planned future state, and which statement supersedes the other."
    }
  ],
  "section_rules": {
    "metadata": {
      "criteria_reference": "CRIT-METADATA",
      "required_quality": "The proposal is identifiable: name, type, location, proposer, and short executive summary are clear.",
      "rules": [
        {
          "rule_id": "META-PROPOSAL-IDENTIFIABLE",
          "field_ids": [
            "project_name",
            "project_type",
            "facility_location",
            "proposer",
            "executive_summary"
          ],
          "severity": "high",
          "evidence_needed": "Enough context for another stakeholder to recognize the proposal and owner.",
          "validators": [
            {"type": "non_empty"},
            {"type": "evidence_present"},
            {"type": "min_detail", "min": 8, "min_items": 1}
          ]
        }
      ]
    },
    "situation_appraisal": {
      "criteria_reference": "CRIT-SA",
      "required_quality": "The concern is framed as a work-related issue, with priority, complexity, affected people, and action needs visible.",
      "rules": [
        {
          "rule_id": "SA-CONCERN-CLEAR",
          "field_ids": [
            "current_architecture",
            "concerns",
            "priorities"
          ],
          "severity": "high",
          "evidence_needed": "Current workflow, main concerns, and why these concerns matter first.",
          "validators": [
            {"type": "non_empty"},
            {"type": "evidence_present"},
            {"type": "min_detail", "min": 30, "min_items": 2}
          ]
        },
        {
          "rule_id": "SA-SUPPORTING-INFORMATION",
          "field_ids": [
            "baseline_metrics",
            "unknowns"
          ],
          "severity": "medium",
          "evidence_needed": "Baseline data, documents, or known unknowns that shape the appraisal.",
          "validators": [
            {"type": "non_empty"},
            {"type": "min_detail", "min": 20, "min_items": 1},
            {"type": "specificity_signal", "signals": ["number_or_metric", "explicit_none_allowed"], "min_matches": 1}
          ]
        }
      ]
    },
    "problem_analysis": {
      "criteria_reference": "CRIT-PA",
      "required_quality": "The issue is expressed as a positive or negative deviation with an observable effect and probable cause.",
      "rules": [
        {
          "rule_id": "PA-DEVIATION-SPECIFIC",
          "field_ids": [
            "problem_statement"
          ],
          "severity": "high",
          "evidence_needed": "Specific bottleneck, deviation, symptom, or failure point.",
          "validators": [
            {"type": "non_empty"},
            {"type": "evidence_present"},
            {"type": "min_detail", "min": 35, "min_items": 1},
            {"type": "specificity_signal", "signals": ["number_or_metric", "time_or_schedule", "owner_or_location"], "min_matches": 1}
          ]
        },
        {
          "rule_id": "PA-CAUSE-SUPPORTED",
          "field_ids": [
            "possible_causes",
            "most_probable_cause"
          ],
          "severity": "high",
          "evidence_needed": "Candidate causes and the evidence supporting the most probable cause.",
          "validators": [
            {"type": "non_empty"},
            {"type": "evidence_present"},
            {"type": "min_detail", "min": 30, "min_items": 1},
            {"type": "specificity_signal", "signals": ["cause_language"], "min_matches": 1}
          ]
        }
      ]
    },
    "decision_analysis": {
      "criteria_reference": "CRIT-DA",
      "required_quality": "The choice is explicit, musts are separated from wants, alternatives are visible, and recommendation is justified.",
      "rules": [
        {
          "rule_id": "DA-OBJECTIVE-AND-REQUIREMENTS",
          "field_ids": [
            "objective",
            "musts",
            "wants"
          ],
          "severity": "high",
          "evidence_needed": "Decision objective, non-negotiable requirements, and optional preferences.",
          "validators": [
            {"type": "non_empty"},
            {"type": "evidence_present"},
            {"type": "min_detail", "min": 25, "min_items": 2}
          ]
        },
        {
          "rule_id": "DA-OPTIONS-AND-RECOMMENDATION",
          "field_ids": [
            "options",
            "recommended_setup"
          ],
          "severity": "high",
          "evidence_needed": "Alternatives considered and why the recommended setup is best.",
          "validators": [
            {"type": "non_empty"},
            {"type": "evidence_present"},
            {"type": "min_detail", "min": 30, "min_items": 2},
            {"type": "specificity_signal", "signals": ["comparison_or_alternative", "cause_language"], "min_matches": 1}
          ]
        }
      ]
    },
    "potential_problem_analysis": {
      "criteria_reference": "CRIT-PPA",
      "required_quality": "The plan is protected by identifying likely future problems plus preventive and contingent actions.",
      "rules": [
        {
          "rule_id": "PPA-RISKS-PREVENTION-CONTINGENCY",
          "field_ids": [
            "risks",
            "preventive_actions",
            "contingency_plans"
          ],
          "severity": "high",
          "evidence_needed": "What could go wrong, what will prevent it, and what to do if it happens.",
          "validators": [
            {"type": "non_empty"},
            {"type": "evidence_present"},
            {"type": "min_detail", "min": 25, "min_items": 2},
            {"type": "specificity_signal", "signals": ["risk_language", "explicit_none_allowed"], "min_matches": 1}
          ]
        }
      ]
    },
    "technical_specifications_and_settings": {
      "criteria_reference": "CRIT-TECH",
      "required_quality": "Technical and configuration dependencies are explicit enough for implementation review.",
      "rules": [
        {
          "rule_id": "TECH-SPECS-CONFIG-CLEAR",
          "field_ids": [
            "system_specifications",
            "software_or_tooling_configuration"
          ],
          "severity": "medium",
          "evidence_needed": "Systems, settings, tools, configuration, or technical assumptions.",
          "validators": [
            {"type": "non_empty"},
            {"type": "min_detail", "min": 20, "min_items": 1}
          ]
        }
      ]
    },
    "ehs_and_operational_impacts": {
      "criteria_reference": "CRIT-EHS-OPS",
      "required_quality": "Safety, environmental, maintenance, and operational impacts are checked before implementation.",
      "rules": [
        {
          "rule_id": "EHS-OPS-IMPACT-CHECKED",
          "field_ids": [
            "safety_ehs",
            "operational_impacts"
          ],
          "severity": "medium",
          "evidence_needed": "EHS risk level, mitigation, maintenance impact, operational disruption, or confirmation of no impact.",
          "validators": [
            {"type": "non_empty"},
            {"type": "min_detail", "min": 20, "min_items": 1},
            {"type": "specificity_signal", "signals": ["risk_language", "explicit_none_allowed"], "min_matches": 1}
          ]
        }
      ]
    },
    "logistics_and_time_saving_suggestions": {
      "criteria_reference": "CRIT-LOGISTICS",
      "required_quality": "Implementation timing is realistic and optimization opportunities are captured.",
      "rules": [
        {
          "rule_id": "LOGISTICS-TIME-BASELINE-OPTIMIZED",
          "field_ids": [
            "standard_implementation_time_hours",
            "suggested_time_saving_method",
            "optimized_installation_time_hours"
          ],
          "severity": "low",
          "evidence_needed": "Expected time, possible time-saving method, and optimized estimate.",
          "validators": [
            {"type": "non_empty"},
            {"type": "min_detail", "min": 10, "min_items": 1},
            {"type": "specificity_signal", "signals": ["number_or_metric", "time_or_schedule", "explicit_none_allowed"], "min_matches": 1}
          ]
        }
      ]
    },
    "additional_information": {
      "criteria_reference": "CRIT-EVIDENCE",
      "required_quality": "Open questions, supporting information, and stakeholder knowledge sources are visible.",
      "rules": [
        {
          "rule_id": "INFO-EVIDENCE-AND-OPEN-QUESTIONS",
          "field_ids": [
            "open_questions",
            "evidence_logs"
          ],
          "severity": "medium",
          "evidence_needed": "Documents, reports, data, samples, stakeholders, or remaining questions.",
          "validators": [
            {"type": "non_empty"},
            {"type": "min_detail", "min": 15, "min_items": 1}
          ]
        }
      ]
    }
  }
}
